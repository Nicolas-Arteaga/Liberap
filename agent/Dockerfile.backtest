# Backtest API — motor de backtest dinamico, reusa verge_agent.py/risk_manager.py
# directo (mismo codigo que produccion) via import, no via HTTP. HTTP :8010.
FROM python:3.12-slim-bookworm

WORKDIR /app

COPY agent/requirements-backtest.txt /app/requirements-backtest.txt
RUN pip install --no-cache-dir -r /app/requirements-backtest.txt

COPY agent/ /app/

# engine.py hace sys.path.insert(python-service) via ruta relativa
# (../../python-service desde agent/backtest/) para reusar FvgAnalyzer /
# AdnCompressionAnalyzer reales sin duplicar el codigo -- necesita existir
# como hermano de /app para que esa ruta relativa resuelva igual que en host.
COPY python-service/fvg /python-service/fvg
COPY python-service/adn_compression /python-service/adn_compression
COPY python-service/shared_kline_cache.py /python-service/shared_kline_cache.py

ENV PYTHONUNBUFFERED=1
EXPOSE 8010

HEALTHCHECK --interval=30s --timeout=8s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8010/backtest/symbols', timeout=5)"

CMD ["python", "-m", "backtest.api"]
